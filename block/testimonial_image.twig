{% if is_preview %}
  <p><strong>Testimonials</strong> - I will only appear in the editor.</p>
{% endif %}

{% if not is_preview %}
<div class="container-new testimonial-container flex items-center bg-gradient p-8 sm:p-16 md:p-8 {{ theme_text_color }}">
  <div class="testimonial-container__img flex items-center {% if fields.full_width|length > 0 %}full_width{% endif %}"> 
      <img src="{{ fields.quotee_img }}">
  </div>
  <div class="relative">
    <div class="testimonial-container__icon">
      <img src='data:image/svg+xml;base64,'/>
    </div>
    <div class="testimonial-container__text text-xl md:text-2xl mb-6 leading-tight">
      {{ fields.testimonial }}
    </div>
    {% if fields.quotee|length > 0 %}
      <div class="testimonial-container__author font-normal">
        <!-- One long line only way to remove space before comma -->
        <span class="font-semibold">{{ fields.quotee }}</span>{% if fields.quotee_role|length > 0 %}<span class="inline italic"> • {{ fields.quotee_role }}</span>{% endif %}
      </div>
    {% endif %}
  </div>
</div>
{% endif %}
