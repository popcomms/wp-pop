{% if is_preview %}
  <p><strong>Grid cards</strong> - I will only appear in the editor.</p>
{% endif %}


{% if not is_preview %}

{% if fields.block_color == 'white' %}
  {% set theme = 'light' %}
{% elseif fields.block_color == 'black' %}
  {% set theme = 'dark' %}
{% endif %}

 <div class="container-new container-cards cols-3" >
    <div class="md:{{ theme == 'dark' ? 'border-pop-black' : 'border-pop-white'}} {{ theme == 'dark' ? 'bg-pop-black' : 'bg-pop-white'}} md:box-content">
       <div class="container-cards-list__title items-center flex {% if fields.button.url == null %} text-center justify-center mb-48 {% else %} justify-between {% endif %}">
        {% include "/templates/partial/component-title-clear.twig" with
          {
            'title': fields.title,
            'subtitle': fields.subtitle,
            'theme_text_color': theme_text_color,
            'theme_text_align': theme_text_align,
            'title_color': fields.title_color,
            'text_align': fields.text_align,
            'pattern': fields.pattern.type,
            'pattern_color': fields.pattern.color,
            'pattern_opacity': fields.pattern.opacity
          }
        %}
        {% if fields.button.url %}
          <a href="{{ fields.button.url }}" target="{{ fields.button.target }}" class="header__button button button--primary">
              {{ fields.button.title}}
          </a>
        {% endif %}
      </div>
      <div class="container-cards__wrapper relative flex flex-wrap {{ fields.list|length <= 4 ? 'cards-cols-2' : '' }} {{ fields.cards_gap == 1 ? 'cards-gap' : '' }} {{ theme == 'dark' ? 'bg-pop-black' : 'bg-pop-white'}}">
        {% for item in fields.list %}
          <div class="grid__item card__item">
            <img src="{{ item.icon }}" width="55" height="55" class="grid__icon"/>
            <h4 class="grid__title {{ fields.title_more_bold == true ? 'font-semibold' : 'font-medium' }} mb-4 text-pop-{{ fields.title_color }}">
              {{ item.title }}
            </h4>
            <div class="grid__descr {{ theme == 'dark' ? 'text-pop-white': 'text-pop-dark' }}">
              {{ item.description }}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

{% endif %}
