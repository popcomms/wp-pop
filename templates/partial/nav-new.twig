    </a>

    <nav
      id="nav-main"
      class="relative nav-main__wrapper h-full flex-grow flex flex-col pl-8"
      role="navigation"
    >
      <div
        class="mobile-burger absolute top-0 right-0 group flex items-center z-50 cursor-pointer md:relative md:hidden"
        @click="toggleMenu('main')"
      >
        <transition name="menu-button" mode="out-in">
          <p
            v-if="!menuActive"
            class="font-semibold text-pop-white pr-3"
            key="menu"
          >
            Menu
          </p>
          <p
            v-else
            class="block md:hidden font-semibold text-pop-white pr-3"
            key="close"
          >
            Close
          </p>
        </transition>
        <svg width="44" height="35" viewBox="0 0 44 35" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line class="text-pop-gray stroke-current" x1="10" y1="9.5" x2="34" y2="9.5" stroke-width="2"/>
          <line class="text-pop-gray stroke-current transform transition-transform" :class="{'translate-x-0.5': menuActive}" x1="10" y1="16.5" x2="34" y2="16.5" stroke-width="2"/>
          <line class="text-pop-gray stroke-current transform transition-transform delay-100" :class="{'translate-x-1': menuActive}" x1="10" y1="23.5" x2="34" y2="23.5" stroke-width="2"/>
        </svg>
      </div>
      {% include "menu.twig" with {'items': menu_new.get_items, 'invert': invertNav} %}
    </nav>

    
    <div class="header__button_w">
      <a href="/book-a-demo/" target="{{ fields.button.target }}" class="small__button button button--primary">
          Book a discovery call
      </a>
    </div>
    
  </div>
</div>
</div>
<!--</header>-->
  {% endblock %}
</header>
