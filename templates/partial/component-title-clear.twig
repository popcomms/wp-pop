{% set title_color_class = theme_text_color %}
{% set text_align_class = theme_text_align %}
{% if title_color != null %}
  {% if title_color != 'theme' %}
    {% set title_color_class = 'text-pop-' ~ title_color %}
  {% endif %}
{% endif %}

{% if text_align != null %}
  {% if text_align != 'theme' %}
    {% set text_align_class = 'text-align-' ~ text_align %}
  {% endif %}
{% endif %}

{% if title|length > 0 %}
  <div class="relative {{ title_color_class }} {{ text_align_class }}">
    <h2 class="{{ subtitle == '' ? '' : 'mb-3'}}">{{ title }}</h2>
   {% if subtitle|length > 0 %} <div class="descr {{ theme == 'dark' ? 'text-pop-white' : 'text-pop-black' }}">{{ subtitle }}</div>{% endif %}
  </div>
{% endif %}
