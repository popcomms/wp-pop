<tr>
  <td>
    <table width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#ffffff" style="border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; text-align: left; background-color: #ffffff;" class="dark-background">
      <tr>
        <td width="25" style="line-height: 0px; font-size: 0px;"><img width="25" height="1" border="0" alt="" src="{{ img_path }}s.png" style="display: block;" /></td>
        <td style="line-height: 0px; font-size: 0px;">
          <table width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#ffffff" style="border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; text-align: left; background-color: #ffffff;" class="dark-background">
            <tr>
              <td style="font-family: {{ font_family }}; font-size: 11px; line-height: 16px; color: {{ text_colour }}; font-weight: normal; text-align: center;">Please note: This email was sent from a notification-only address that can't accept incoming email. Please do not reply to this message.{% if unsubscribe_link %} You may <a href="{{ unsubscribe_link }}" style="font-family: {{ font_family }}; font-size: 11px; line-height: 16px; color: {{ text_colour }}; font-weight: normal; text-decoration: underline;">unsubscribe from future messages</a>.{% endif %}</td>
            </tr>
          </table>
        </td>
        <td width="25" style="line-height: 0px; font-size: 0px;"><img width="25" height="1" border="0" alt="" src="{{ img_path }}s.png" style="display: block;" /></td>
      </tr>
      <tr><td colspan="3" style="line-height: 0px; font-size: 0px;"><img src="{{ img_path }}s.png" alt="" width="1" height="25" border="0" style="display: block;" /></td></tr>
    </table>
  </td>
</tr>
